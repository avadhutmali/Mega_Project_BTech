# =============================================================================
# IdleGrid Dashboard — Environment Variables
# =============================================================================
# Copy this file to .env.local to override for your local setup.
# .env.local is git-ignored and will not be committed.
#
# VITE_MASTER_URL  — Full base URL of the IdleGrid Master (backend).
#                    Change this to the IP/port of whichever PC is running
#                    the Spring Boot backend.
#
#   Same machine  : http://localhost:9090
#   LAN / lab PC  : http://192.168.1.XX:9090   (replace XX with master PC's IP)
# =============================================================================

VITE_MASTER_URL=http://localhost:9090
